{
  "name": "kukgit",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "KukGit \u2014 AI-first Git hosting and developer operating system.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --watch server.mjs",
    "start": "node server.mjs",
    "seed": "node scripts/seed.mjs",
    "doctor": "node scripts/doctor.mjs && node scripts/doctor-database.mjs",
    "token": "node scripts/token.mjs",
    "backup": "node scripts/backup.mjs",
    "deploy": "./scripts/deploy.sh",
    "rehearse": "node scripts/recovery-rehearsal.mjs",
    "authkit:rehearse": "node scripts/authkit-rehearse.mjs",
    "runner": "node scripts/runner.mjs",
    "runner:install": "./scripts/runner-install.sh",
    "lfs:storage": "node scripts/lfs-storage.mjs",
    "drill": "node scripts/rollout-drill.mjs",
    "scan": "node scripts/secret-scan.mjs",
    "export": "node scripts/tenant-export.mjs",
    "import": "node scripts/tenant-import.mjs",
    "status": "node scripts/status.mjs",
    "deploy:check": "node scripts/deploy-check.mjs",
    "database": "node scripts/database.mjs",
    "database:runtime-write-surface": "node scripts/database.mjs runtime-write-surface",
    "database:postgresql-import": "node scripts/postgresql-import.mjs",
    "database:postgresql-shadow": "node scripts/postgresql-shadow.mjs",
    "ssh:authorized-keys": "node scripts/authorized-keys.mjs",
    "check": "for f in server.mjs src/*.mjs scripts/*.mjs test-support/*.mjs public/*.js; do node --check \"$f\" || exit 1; done",
    "test": "NODE_ENV=test node --test --test-reporter=spec",
    "ci": "node scripts/ci.mjs",
    "postgres:dev": "node scripts/postgres-dev.mjs",
    "deps": "node scripts/dependencies.mjs check",
    "sbom": "node scripts/dependencies.mjs sbom",
    "vulns": "node scripts/vulnerabilities.mjs"
  },
  "dependencies": {
    "pg": "8.22.0"
  },
  "license": "UNLICENSED"
}
