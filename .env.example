PORT=8787
HOST=0.0.0.0
KUKGIT_BASE_URL=http://localhost:8787
KUKGIT_DATA_DIR=./data

# Metadata database and migration controls.
# Application runtime remains SQLite. PostgreSQL import and shadow verification are
# explicitly gated; runtime cutover is still blocked.
KUKGIT_DATABASE_DRIVER=sqlite
KUKGIT_DATABASE_URL=postgresql://migration_user:replace-me@db.example.com:5432/kukgit
KUKGIT_POSTGRESQL_READINESS_MARKER=./data/postgresql-readiness.json
KUKGIT_POSTGRESQL_REQUIRE_VERIFIED_CUTOVER=true
KUKGIT_POSTGRESQL_IMPORT_ENABLED=false
KUKGIT_POSTGRESQL_SCHEMA=kukgit_migration
KUKGIT_POSTGRESQL_ALLOW_PUBLIC_SCHEMA=false
KUKGIT_POSTGRESQL_APPLICATION_NAME=kukgit-migration
KUKGIT_POSTGRESQL_SSL_MODE=verify-full
KUKGIT_POSTGRESQL_SSL_CA=
KUKGIT_POSTGRESQL_SSL_CERT=
KUKGIT_POSTGRESQL_SSL_KEY=
KUKGIT_POSTGRESQL_ALLOW_UNVERIFIED_TLS=false
KUKGIT_POSTGRESQL_ALLOW_INSECURE=false
KUKGIT_POSTGRESQL_CONNECTION_TIMEOUT_MS=10000
KUKGIT_POSTGRESQL_STATEMENT_TIMEOUT_MS=120000
KUKGIT_POSTGRESQL_QUERY_TIMEOUT_MS=130000
KUKGIT_POSTGRESQL_LOCK_TIMEOUT_MS=5000
KUKGIT_POSTGRESQL_IDLE_TRANSACTION_TIMEOUT_MS=60000

# Read-only Stage 5 parity checks. SQLite remains authoritative.
KUKGIT_POSTGRESQL_SHADOW_ENABLED=false
KUKGIT_POSTGRESQL_SHADOW_OUTPUT_DIR=./data/database-migration/postgresql-shadow
KUKGIT_POSTGRESQL_SHADOW_SAMPLE_LIMIT=10
KUKGIT_POSTGRESQL_SHADOW_READ_TIMEOUT_MS=5000

# Authentication
# Development defaults to local. Production always uses central AuthKit.
KUKGIT_AUTH_MODE=local
KUKGIT_AUTHKIT_BASE_URL=https://auth.kuklabs.com
KUKGIT_AUTHKIT_PRODUCT_ID=kukgit
KUKGIT_AUTHKIT_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
KUKGIT_AUTHKIT_TIMEOUT_MS=8000
KUKGIT_AUTHKIT_REFRESH_TTL_DAYS=60

# Real-time in-app notifications over WebSocket.
KUKGIT_REALTIME_HEARTBEAT_MS=25000
KUKGIT_REALTIME_AUTH_REVALIDATE_MS=60000
KUKGIT_REALTIME_MAX_CONNECTIONS_PER_USER=10
KUKGIT_REALTIME_MAX_CONNECTIONS=5000
KUKGIT_REALTIME_MAX_MESSAGE_BYTES=4096

# Self-service workspace ownership limit per user.
KUKGIT_ORGANIZATION_OWNER_LIMIT=5

KUKGIT_LFS_DIR=./data/lfs
KUKGIT_LFS_MAX_OBJECT_BYTES=5368709120
KUKGIT_LFS_REPOSITORY_QUOTA_BYTES=21474836480
KUKGIT_LFS_INSTANCE_QUOTA_BYTES=107374182400
KUKGIT_LFS_UPLOAD_EXPIRY_SECONDS=3600
KUKGIT_LFS_AUTH_KEY=replace-with-at-least-32-random-characters
KUKGIT_BACKUPS_DIR=./data/backups
KUKGIT_BACKUP_RETENTION_COUNT=14
KUKGIT_BACKUP_RETENTION_DAYS=30
KUKGIT_MAINTENANCE_PATH=./data/maintenance.json
KUKGIT_BACKUP_LOCK_PATH=./data/backup.lock
KUKGIT_ADMIN_EMAIL=admin@kuklabs.local
KUKGIT_ADMIN_PASSWORD=change-this-before-production
KUKGIT_ADMIN_NAME=Amit Kumar Kuklod
# Comma-separated verified One Kuklabs Account emails. Falls back to KUKGIT_ADMIN_EMAIL.
KUKGIT_INSTANCE_ADMIN_EMAILS=support@kuklabs.com
KUKGIT_DEV_GIT_TOKEN=replace-with-a-long-random-token
KUKGIT_COOKIE_SECURE=false
KUKGIT_WEBHOOK_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
KUKGIT_SMTP_HOST=smtp.example.com
KUKGIT_SMTP_PORT=587
KUKGIT_SMTP_SECURE=false
KUKGIT_SMTP_STARTTLS=true
KUKGIT_SMTP_REJECT_UNAUTHORIZED=true
KUKGIT_SMTP_USER=
KUKGIT_SMTP_PASSWORD=
KUKGIT_EMAIL_FROM=noreply@example.com
KUKGIT_EMAIL_FROM_NAME=KukGit
KUKGIT_EMAIL_REPLY_TO=
KUKGIT_EMAIL_WORKER_INTERVAL_MS=30000
KUKGIT_EMAIL_MAX_ATTEMPTS=8
KUKGIT_EMAIL_BATCH_SIZE=20

# Signed delivery events from the configured email provider.
KUKGIT_EMAIL_PROVIDER_EVENTS_ENABLED=true
KUKGIT_EMAIL_PROVIDER_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
KUKGIT_EMAIL_PROVIDER_WEBHOOK_TOLERANCE_SECONDS=300
KUKGIT_EMAIL_SOFT_BOUNCE_THRESHOLD=3
KUKGIT_EMAIL_SOFT_BOUNCE_WINDOW_DAYS=7
KUKGIT_EMAIL_SOFT_BOUNCE_SUPPRESSION_DAYS=30

KUKGIT_SSH_HOST=git.kuklabs.com
KUKGIT_SSH_PORT=22
KUKGIT_SSH_USER=git
KUKGIT_NODE_BINARY=/usr/bin/node
KUKGIT_SSH_COMMAND_SCRIPT=/opt/kukgit/scripts/ssh-command.mjs
KUKGIT_AUTHORIZED_KEYS_PATH=./data/ssh/authorized_keys
KUKGIT_AI_ENDPOINT=
KUKGIT_AI_API_KEY=
